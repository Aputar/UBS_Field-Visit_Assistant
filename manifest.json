@import"https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap";:root{--navy: #0f2744;--navy-light: #1a3a5c;--navy-dark: #091c33;--accent: #e8a020;--accent-light: #fdf3e3;--red: #d63230;--red-bg: #fdf0f0;--green: #1a7a4a;--green-bg: #edfaf3;--amber: #c47a00;--amber-bg: #fff8e8;--blue: #1565c0;--blue-bg: #e8f0fe;--bg: #f4f5f7;--surface: #ffffff;--surface2: #f9fafb;--border: #e2e5ea;--border2: #d0d4db;--text: #111827;--text2: #4b5563;--text3: #9ca3af;--radius: 12px;--radius-sm: 8px;--shadow: 0 1px 3px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.04);--shadow-md: 0 4px 12px rgba(0,0,0,.1)}*{box-sizing:border-box;margin:0;padding:0}html,body,#root{height:100%;font-family:DM Sans,sans-serif;background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased}.app-shell{max-width:430px;margin:0 auto;min-height:100vh;display:flex;flex-direction:column;background:var(--bg);position:relative}.main-content{flex:1;overflow-y:auto;padding-bottom:80px}.topbar{background:var(--navy);padding:0;position:sticky;top:0;z-index:100}.topbar-inner{padding:14px 16px 10px;display:flex;justify-content:space-between;align-items:flex-start}.topbar-logo{font-size:11px;font-weight:600;color:var(--accent);letter-spacing:2px;text-transform:uppercase;font-family:DM Mono,monospace}.topbar-user{text-align:right}.topbar-name{font-size:13px;font-weight:500;color:#fff}.topbar-role{font-size:10px;color:#ffffff8c;margin-top:1px}.topbar-logout{font-size:10px;color:var(--accent);cursor:pointer;margin-top:2px}.bottom-nav{position:fixed;bottom:0;left:50%;transform:translate(-50%);width:100%;max-width:430px;background:var(--surface);border-top:1px solid var(--border);display:flex;z-index:200;padding-bottom:env(safe-area-inset-bottom)}.nav-btn{flex:1;padding:10px 4px 8px;border:none;background:transparent;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:3px;font-size:9px;color:var(--text3);font-family:DM Sans,sans-serif;transition:color .15s}.nav-btn.active{color:var(--navy)}.nav-btn svg{width:22px;height:22px;stroke-width:1.8}.nav-btn.active svg{stroke:var(--navy)}.nav-btn.new-visit{background:var(--navy);border-radius:14px;color:#fff;margin:6px 4px;padding:6px}.nav-btn.new-visit svg{stroke:#fff}.page{padding:16px}.page-title{font-size:18px;font-weight:600;color:var(--navy);margin-bottom:4px}.page-sub{font-size:12px;color:var(--text3);margin-bottom:16px}.card{background:var(--surface);border-radius:var(--radius);border:1px solid var(--border);padding:14px;box-shadow:var(--shadow)}.card+.card{margin-top:10px}.metrics-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}.metric-card{background:var(--surface);border-radius:var(--radius);border:1px solid var(--border);padding:12px 14px}.metric-val{font-size:28px;font-weight:600;color:var(--navy);line-height:1}.metric-label{font-size:11px;color:var(--text3);margin-top:4px}.metric-change{font-size:10px;margin-top:6px;font-weight:500}.metric-change.up{color:var(--green)}.metric-change.dn{color:var(--red)}.section-label{font-size:10px;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:1px;margin:20px 0 10px}.badge{font-size:10px;font-weight:600;padding:3px 8px;border-radius:99px;display:inline-flex;align-items:center;gap:3px}.badge-red{background:var(--red-bg);color:var(--red)}.badge-amber{background:var(--amber-bg);color:var(--amber)}.badge-green{background:var(--green-bg);color:var(--green)}.badge-blue{background:var(--blue-bg);color:var(--blue)}.badge-navy{background:var(--navy);color:#fff}.form-group{margin-bottom:14px}.form-label{font-size:11px;font-weight:600;color:var(--text2);margin-bottom:5px;display:block;text-transform:uppercase;letter-spacing:.5px}.form-input,.form-select,.form-textarea{width:100%;padding:10px 12px;border-radius:var(--radius-sm);border:1px solid var(--border2);font-size:14px;font-family:DM Sans,sans-serif;color:var(--text);background:var(--surface);transition:border-color .15s}.form-input:focus,.form-select:focus,.form-textarea:focus{outline:none;border-color:var(--navy)}.form-textarea{resize:vertical;min-height:80px;line-height:1.6}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}.tag-grid{display:flex;flex-wrap:wrap;gap:6px}.tag-pill{font-size:12px;padding:5px 12px;border-radius:99px;border:1px solid var(--border2);cursor:pointer;color:var(--text2);background:var(--surface);transition:all .15s;-webkit-user-select:none;user-select:none}.tag-pill.selected{background:var(--navy);color:#fff;border-color:var(--navy)}.btn-primary{width:100%;padding:13px;background:var(--navy);color:#fff;border:none;border-radius:var(--radius-sm);font-size:15px;font-weight:600;font-family:DM Sans,sans-serif;cursor:pointer;transition:background .15s}.btn-primary:hover{background:var(--navy-dark)}.btn-primary:disabled{background:var(--text3);cursor:not-allowed}.btn-secondary{padding:8px 16px;background:transparent;color:var(--navy);border:1px solid var(--navy);border-radius:var(--radius-sm);font-size:13px;font-weight:500;font-family:DM Sans,sans-serif;cursor:pointer}.btn-danger{padding:6px 12px;background:var(--red-bg);color:var(--red);border:1px solid var(--red);border-radius:var(--radius-sm);font-size:12px;font-family:DM Sans,sans-serif;cursor:pointer}.btn-icon{width:32px;height:32px;border-radius:8px;border:1px solid var(--border);background:var(--surface2);display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text2)}.alert{display:flex;gap:10px;padding:10px 12px;border-radius:var(--radius-sm);margin-bottom:12px;font-size:12px;align-items:flex-start;line-height:1.5}.alert-warn{background:var(--amber-bg);color:#7c4f00;border:1px solid #ffd580}.alert-info{background:var(--blue-bg);color:#174ea6;border:1px solid #aecbfa}.action-card{background:var(--surface);border-radius:var(--radius);border:1px solid var(--border);padding:12px 14px;margin-bottom:8px}.action-title{font-size:14px;font-weight:500;color:var(--text)}.action-meta{font-size:11px;color:var(--text3);margin-top:4px;display:flex;flex-wrap:wrap;gap:8px}.action-footer{display:flex;justify-content:space-between;align-items:center;margin-top:10px;padding-top:10px;border-top:1px solid var(--border)}.action-due{font-size:11px;color:var(--text3)}.action-due.overdue{color:var(--red);font-weight:600}.status-select{font-size:12px;padding:4px 8px;border-radius:6px;border:1px solid var(--border2);background:var(--surface2);color:var(--text);font-family:DM Sans,sans-serif;cursor:pointer}.depot-card{background:var(--surface);border-radius:var(--radius);border:1px solid var(--border);padding:12px 14px;margin-bottom:8px;cursor:pointer;transition:border-color .15s}.depot-card:hover{border-color:var(--navy-light)}.depot-header{display:flex;justify-content:space-between;align-items:center}.depot-name{font-size:14px;font-weight:600;color:var(--navy)}.depot-meta{font-size:11px;color:var(--text3);margin-top:4px}.progress-row{display:flex;align-items:center;gap:8px;margin-top:8px}.progress-bar{flex:1;height:4px;background:var(--border);border-radius:2px}.progress-fill{height:100%;border-radius:2px;background:var(--navy)}.progress-pct{font-size:10px;color:var(--text3);min-width:26px;text-align:right}.timeline{display:flex;flex-direction:column;gap:0}.tl-item{display:flex;gap:12px;padding-bottom:18px;position:relative}.tl-dot{width:10px;height:10px;border-radius:50%;background:var(--navy);margin-top:3px;flex-shrink:0}.tl-line{position:absolute;left:4px;top:13px;bottom:0;width:2px;background:var(--border)}.tl-date{font-size:10px;color:var(--text3);font-family:DM Mono,monospace}.tl-text{font-size:13px;color:var(--text);margin-top:3px;line-height:1.5}.tl-tags{display:flex;gap:4px;margin-top:6px;flex-wrap:wrap}.login-screen{min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;background:var(--navy);padding:32px 24px}.login-logo{font-size:13px;font-weight:600;color:var(--accent);letter-spacing:3px;font-family:DM Mono,monospace;margin-bottom:4px}.login-title{font-size:28px;font-weight:600;color:#fff;margin-bottom:4px}.login-sub{font-size:13px;color:#ffffff80;margin-bottom:36px}.login-card{background:var(--surface);border-radius:var(--radius);padding:24px;width:100%;max-width:360px}.login-hint{font-size:11px;color:var(--text3);margin-top:12px;text-align:center}.master-tabs{display:flex;gap:6px;margin-bottom:16px;overflow-x:auto;padding-bottom:4px}.master-tab{padding:7px 14px;border-radius:99px;border:1px solid var(--border2);font-size:12px;font-weight:500;cursor:pointer;background:var(--surface);color:var(--text2);white-space:nowrap;font-family:DM Sans,sans-serif}.master-tab.active{background:var(--navy);color:#fff;border-color:var(--navy)}.search-wrap{position:relative;margin-bottom:12px}.search-wrap svg{position:absolute;left:10px;top:50%;transform:translateY(-50%);width:16px;height:16px;stroke:var(--text3)}.search-input{width:100%;padding:9px 12px 9px 34px;border-radius:var(--radius-sm);border:1px solid var(--border2);font-size:13px;font-family:DM Sans,sans-serif;background:var(--surface);color:var(--text)}.search-input:focus{outline:none;border-color:var(--navy)}.empty-state{text-align:center;padding:40px 20px;color:var(--text3)}.empty-state svg{width:40px;height:40px;stroke:var(--border2);margin-bottom:12px}.empty-state p{font-size:13px}.filter-row{display:flex;gap:6px;overflow-x:auto;padding-bottom:4px;margin-bottom:12px}.filter-pill{padding:6px 14px;border-radius:99px;border:1px solid var(--border2);font-size:12px;cursor:pointer;background:var(--surface);color:var(--text2);white-space:nowrap;font-family:DM Sans,sans-serif;flex-shrink:0}.filter-pill.active{background:var(--navy);color:#fff;border-color:var(--navy)}.bar-row{display:flex;align-items:center;gap:8px;margin-bottom:8px}.bar-label{font-size:11px;color:var(--text2);width:90px;text-align:right;flex-shrink:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.bar-track{flex:1;height:18px;background:var(--surface2);border-radius:4px;overflow:hidden}.bar-fill{height:100%;background:var(--navy);border-radius:4px;display:flex;align-items:center;justify-content:flex-end;padding-right:6px;min-width:24px;transition:width .4s ease}.bar-fill span{font-size:10px;color:#fff;font-weight:600}.bar-fill.accent{background:var(--accent)}.bar-fill span.dark{color:var(--navy)}.modal-overlay{position:fixed;top:0;right:0;bottom:0;left:0;background:rgba(0,0,0,.5);z-index:300;display:flex;align-items:flex-end;justify-content:center}.modal-sheet{background:var(--surface);border-radius:20px 20px 0 0;width:100%;max-width:430px;padding:20px 16px 32px;max-height:90vh;overflow-y:auto}.modal-handle{width:36px;height:4px;background:var(--border2);border-radius:2px;margin:0 auto 16px}.modal-title{font-size:16px;font-weight:600;color:var(--navy);margin-bottom:16px}.toast{position:fixed;bottom:90px;left:50%;transform:translate(-50%);background:var(--navy);color:#fff;padding:10px 20px;border-radius:99px;font-size:13px;font-weight:500;z-index:500;animation:toastIn .2s ease;white-space:nowrap}@keyframes toastIn{0%{opacity:0;transform:translate(-50%) translateY(10px)}to{opacity:1;transform:translate(-50%) translateY(0)}}
